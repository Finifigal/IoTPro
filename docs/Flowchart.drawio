        <mxCell id="TO7G9DBtdeTpsuaXwEZl-18" value="TỪ CHỐI TRUY CẬP:&#xa;- Còi bíp 3 tiếng cảnh báo&#xa;- Nháy LED Đỏ&#xa;- Báo thẻ không hợp lệ" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="871" y="2492" width="246" height="126" as="geometry" />
