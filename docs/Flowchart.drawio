        <mxCell id="TO7G9DBtdeTpsuaXwEZl-16" value="Mã thẻ hợp lệ?" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="763" y="2259" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-17" value="XÁC THỰC THÀNH CÔNG:&#xa;- Còi nhỏ bíp 1 tiếng&#xa;- Bật sáng LED Xanh&#xa;- Quay Servo mở cửa 5 giây" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="564" y="2492" width="257" height="126" as="geometry" />
