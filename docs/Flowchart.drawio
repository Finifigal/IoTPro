        <mxCell id="TO7G9DBtdeTpsuaXwEZl-5" value="BẮT ĐẦU" style="rounded=1;whiteSpace=wrap;arcSize=50;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="672" y="45" width="90" height="39" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-6" value="Khởi tạo hệ thống:&#xa;- Cấu hình chân GPIO, I2C, SPI&#xa;- Khởi động OLED, MPU-6050, RFID-RC522, DHT22&#xa;- Cố định góc đóng ban đầu cho Servo SG90" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="586" y="134" width="260" height="198" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-7" value="Đọc tín hiệu từ cảm biến &amp;amp; ngoại vi:&#xa;- MQ-2/135: Khí gas, khói&#xa;- DHT22: Nhiệt độ, độ ẩm&#xa;- PIR: Cảm biến chuyển động&#xa;- MPU-6050: Rung chấn, gia tốc&#xa;- LDR: Cường độ ánh sáng&#xa;- RFID: Quét thẻ từ" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="586" y="382" width="260" height="270" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-8" value="Kiểm tra kết nối&#xa;WiFi &amp;amp; Cloud IoT?" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="512" y="727" width="203" height="203" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-9" value="Báo lỗi mạng:&#xa;- Chuyển sang chạy Offline&#xa;- OLED: WiFi Disconnected" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="1004" width="254" height="102" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-10" value="Mạng ổn định:&#xa;- Sẵn sàng đồng bộ Cloud" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="801" y="1016" width="242" height="78" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-11" value="Khí gas/Khói &amp;gt; Ngưỡng&#xa;HOẶC Nhiệt độ &amp;gt; 50°C?" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="490" y="1181" width="246" height="246" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-12" value="BÁO ĐỘNG HỎA HOẠN:&#xa;- Kích hoạt Còi hú lớn Siren&#xa;- Nhấp nháy liên tục LED Đỏ&#xa;- Quay Servo mở cửa thoát hiểm&#xa;- Gửi tin báo cháy khẩn cấp lên App" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="79" y="1540" width="260" height="222" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-13" value="PIR có người&#xa;HOẶC MPU6050 rung lắc mạnh?" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="628" y="1500" width="302" height="302" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-14" value="CẢNH BÁO AN NINH:&#xa;- Còi hú ngắt quãng bíp bíp&#xa;- Nháy LED cảnh báo&#xa;- Gửi thông báo có đột nhập" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="337" y="1955" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="TO7G9DBtdeTpsuaXwEZl-15" value="Có thẻ RFID quẹt vào?" style="rhombus;strokeWidth=2;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="816" y="1924" width="212" height="212" as="geometry" />
