        <mxCell id="TO7G9DBtdeTpsuaXwEZl-3" value="1. AN TOÀN CHÁY NỔ &amp; KHÍ GAS" style="whiteSpace=wrap;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="44" y="1156" width="981" height="670" as="geometry" />
